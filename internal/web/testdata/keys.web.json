{
  "bindings": [
    {
      "key": "j",
      "action": "move:down",
      "context": "list",
      "owner": "core",
      "help": "move down"
    },
    {
      "key": "k",
      "action": "move:up",
      "context": "list",
      "owner": "core",
      "help": "move up"
    },
    {
      "key": "Enter",
      "action": "detail:open",
      "context": "list",
      "owner": "core",
      "help": "open the detail"
    },
    {
      "key": "Esc",
      "action": "detail:close",
      "context": "list",
      "owner": "core",
      "help": "close the detail"
    },
    {
      "key": "x",
      "action": "next",
      "context": "list",
      "owner": "core",
      "help": "to Next",
      "summary": "Move it to Next: something you will do as soon as you can."
    },
    {
      "key": "w",
      "action": "waiting",
      "context": "list",
      "owner": "core",
      "help": "to Waiting",
      "summary": "Move it to Waiting on the people you name; it resurfaces on the date you set."
    },
    {
      "key": "s",
      "action": "schedule",
      "context": "list",
      "owner": "core",
      "help": "schedule or snooze",
      "summary": "Hide it until a date or until its unit moves, then bring it back where it was."
    },
    {
      "key": "y",
      "action": "someday",
      "context": "list",
      "owner": "core",
      "help": "to Someday",
      "summary": "Move it to Someday: not now, kept for a later look."
    },
    {
      "key": "l",
      "action": "reference",
      "context": "list",
      "owner": "core",
      "help": "to Reference",
      "summary": "Keep it as reference: nothing to do, worth finding again."
    },
    {
      "key": "f",
      "action": "focus",
      "context": "list",
      "owner": "core",
      "help": "toggle Focus",
      "summary": "Star it in Focus, or take the star off."
    },
    {
      "key": "p",
      "action": "project",
      "context": "list",
      "owner": "core",
      "help": "make a project or attach to one",
      "summary": "Attach it to a project, or start a new project with it."
    },
    {
      "key": "a",
      "action": "approve",
      "context": "list",
      "owner": "core",
      "help": "approve the draft or proposal",
      "summary": "Approve what it proposes: its draft, its recommended answer or its unit's action."
    },
    {
      "key": "d",
      "action": "delegate",
      "context": "list",
      "owner": "core",
      "help": "delegate to an agent",
      "summary": "Hand it to an agent, which runs its unit's action."
    },
    {
      "key": "e",
      "action": "done",
      "context": "list",
      "owner": "core",
      "help": "done",
      "summary": "Mark it done: it leaves your lists for the Logbook."
    },
    {
      "key": "Backspace",
      "action": "dismiss",
      "context": "list",
      "owner": "core",
      "help": "dismiss",
      "summary": "Throw it away: it goes to the trash, and a draft it carries is discarded."
    },
    {
      "key": "r",
      "action": "reply",
      "context": "list",
      "owner": "core",
      "help": "reply in the conversation",
