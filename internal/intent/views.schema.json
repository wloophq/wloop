{
  "$id": "https://github.com/wloophq/wloop/views.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "review": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "A step of the review: inbox, outbox, waiting, projects, someday or focus.",
        "properties": {
          "label": {
            "description": "What the step asks of you, as the review lists it. Required.",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "description": "The review's steps, by step.",
      "type": "object"
    },
    "views": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "A view, by its name.",
        "properties": {
          "label": {
            "description": "The name people read in the list of views. Required.",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "description": "The lists of tasks, by view.",
      "type": "object"
    }
  },
  "title": "Views and the review (views.toml)",
  "type": "object"
}
