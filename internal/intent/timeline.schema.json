{
  "$id": "https://github.com/wloophq/wloop/timeline.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "events": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "One event kind.",
        "properties": {
          "label": {
            "description": "What the timeline calls an event of the kind, such as \"paused\".",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "type": "object"
      },
      "description": "The core's event kinds, by kind, as the timeline names them.",
      "type": "object"
    }
  },
  "title": "The core's event kinds (timeline.toml)",
  "type": "object"
}
