{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/wloophq/wloop/intent.schema.json",
  "title": "Intent manifest (intent.toml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "summary"
  ],
  "if": {
    "not": {
      "required": [
        "builds"
      ]
    }
  },
  "then": {
    "required": [
      "workspace",
      "session",
      "headline",
      "record"
    ]
  },
  "else": {
    "required": [
      "prompt"
    ]
  },
  "properties": {
    "label": {
      "type": "string",
      "description": "The intent's name as people read it."
    },
    "summary": {
      "type": "string",
      "description": "One line on what the intent does."
    },
    "key": {
      "type": "string",
      "description": "The action's key: one uppercase letter, unique among intents and built-in actions; lowercase letters and digits are the core's.",
      "pattern": "^[A-Z]$"
    },
    "verb": {
      "type": "string",
      "description": "The gtd verb the intent's action fulfills, so the entry verb reaches it.",
      "enum": ["approve", "delegate", "dismiss"]
    },
    "user_facing": {
      "type": "boolean",
      "description": "Offered as a command and an action. Default true."
    },
    "provider": {
      "description": "The provider whose units the intent's turns run on, a registered provider id, or a list of them. Default \"github\".",
      "oneOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}}
      ]
    },
    "workspace": {
      "description": "Where the turn runs: a workspace builtin, or a table naming the repository outright (repo) or by an input (repo_input).",
      "oneOf": [
        {"type": "string", "enum": ["review", "author", "pr_else_main", "given"]},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {"type": "string", "description": "owner/name.", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "repo_input": {"type": "string", "description": "The input that holds owner/name."}
          }
        }
      ]
    },
    "role": {
      "type": "string",
      "description": "What the loop resolves the intent by; one intent per role and provider, a user's taking it from the bundled one.",
      "enum": ["round.review", "round.address", "nudge", "probe", "headless.default"]
    },
    "builds": {
      "type": "string",
      "description": "What a builder intent builds; a builder is never started as a turn and needs no workspace, session or record.",
      "enum": ["brief"]
    },
    "prompt": {"type": "string", "description": "With builds only: the prompt, a path resolved through the profile layers, such as prompts/brief.md."},
    "schema": {"type": "string", "description": "With builds only: the JSON Schema of the extra fields, a file in the intent's directory."},
    "draft_effects": {
      "type": "array",
      "description": "The effects the intent's agents may declare on their drafts. Default none.",
      "items": {"type": "string", "enum": ["entry.nudged", "unit.closed", "pr.nudged"]}
    },
    "round_kind": {"type": "string", "description": "The sweep round the intent's turns are; defaults from the role (round.review, round.address).", "enum": ["review", "address"]},
    "cap": {"type": "string", "description": "The budget the intent's turns spend: rounds, the per pull request daily cap; the default for an intent with a round kind or the nudge role.", "enum": ["rounds"]},
    "reason_fact": {"type": "string", "description": "The workflow fact that says why the intent's round is due or not."},
    "refuse_when": {"type": "string", "description": "A string workflow fact whose non-empty value refuses the turn with that text."},
    "reason": {"type": "string", "description": "The why the turn's instructions carry.", "enum": ["address_round"]},
    "skill": {"type": "boolean", "description": "true has install write the intent a turn skill, which runs a turn by hand from the agent's prompt; it needs help.target."},
    "help": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "description": "What the command's target is, such as \"a pull request URL\"; the turn skill and the command's help read it."},
        "summary": {"type": "string", "description": "The main help's line for the command; default summary."},
        "group": {"type": "string", "description": "The title of the main help's group the command joins, such as \"pull requests\"; default the group of your intents."},
        "examples": {"type": "array", "items": {"type": "string"}, "description": "Command lines of the help, without the command's name."},
        "docs": {"type": "string", "description": "A page path of the documentation site, such as \"guides/review\"."}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "description": "Reuse a live session or start a new one.",
          "enum": [
            "reuse_live",
            "new"
          ]
        },
        "title": {
          "type": "string",
          "description": "The session title.",
          "pattern": "^[a-z]{1,12}$"
        },
        "close_when_done": {
          "type": "boolean",
          "description": "Close the session when the turn ends done. Default false."
        }
      },
      "required": [
        "strategy",
        "title"
      ],
      "description": "The agent session the turn runs in."
    },
    "intake": {
      "type": "boolean",
      "description": "Runs through the intake. Default false."
    },
    "start_line": {
      "type": "string",
      "description": "The intake's start line. Default \"starting the <label in lower case>\"."
    },
    "owner_only": {
      "type": "boolean",
      "description": "Needs the pull request to be yours or taken over. Default false."
    },
    "answerable": {
      "type": "boolean",
      "description": "A turn may stop on a question. Default true."
    },
    "board": {
      "type": "string",
      "description": "Default none.",
      "enum": [
        "review",
        "author",
        "none"
      ]
    },
    "drives_row": {
      "type": "boolean",
      "description": "Default false."
    },
    "reports": {
      "type": "boolean",
      "description": "Default true."
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "render": {
          "type": "boolean",
          "description": "Default true."
        },
        "wait": {
          "type": "boolean",
          "description": "Default true."
        },
        "need": {
          "type": "array",
          "description": "The brief intent's extra fields the turn needs; a brief missing one is completed first.",
          "items": {"type": "string"}
        }
      }
    },
    "profile": {
      "type": "string",
      "description": "An intent name with judgment blocks, or none. Default none."
    },
    "dims": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "round"
        ]
      },
      "description": "Profile dimensions valid under this intent."
    },
    "records": {
      "type": "string",
      "description": "Whether the turn records. Default \"true\". A predicate: a quoted CEL-subset expression."
    },
    "prepare": {
      "type": "string",
      "description": "Default \"\".",
      "enum": [
        "",
        "nudge.prepare"
      ]
    },
    "on_sent": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plan.drop_pending",
          "event.round_sent",
          "event.nudged",
          "record_round",
          "keeps_guidance",
          "mark_reviewed",
          "mark_addressed"
        ]
      },
      "description": "Effects the intent has."
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Default Guidance."
        },
        "help": {
          "type": "string",
          "description": "Default \"\"."
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "description": "Runes; 0 is no limit."
        }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resumed": {
          "type": "string",
          "description": "Template over the turn context."
        },
        "new": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "string",
                "description": "Turn slot. A predicate: a quoted CEL-subset expression."
              },
              "text": {
                "type": "string",
                "description": "Template over the turn context."
              }
            },
            "required": [
              "text"
            ]
          },
          "description": "Cases in order; the last has no when."
        }
      },
      "required": [
        "resumed",
        "new"
      ]
    },
    "inputs": {
      "type": "object",
      "description": "Inputs by name.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "flag",
              "text",
              "list"
            ]
          },
          "flag": {
            "type": "string",
            "description": "Required for from = user.",
            "pattern": "^--[a-z][a-z0-9-]*$"
          },
          "help": {
            "type": "string",
            "description": "Required for from = user."
          },
          "from": {
            "type": "string",
            "description": "Default user.",
            "enum": [
              "user",
              "prepare"
            ]
          },
          "persist": {
            "type": "boolean",
            "description": "Stored with the turn, restored on resume."
          },
          "hidden": {
            "type": "boolean",
            "description": "Not in help."
          },
          "by_hand_only": {
            "type": "boolean",
            "description": "Automatic rounds never set it."
          },
          "before": {
            "type": "string",
            "enum": [
              "take_over"
            ]
          },
          "max": {
            "type": "integer",
            "minimum": 0,
            "description": "Runes, text only."
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "instructions",
                "try"
              ]
            },
            "description": "Default [\"cli\", \"instructions\"]."
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "also_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "type": "string",
            "description": "An intent with judgment blocks."
          },
          "when": {
            "type": "string",
            "description": "Turn slot. A predicate: a quoted CEL-subset expression."
          },
          "round": {
            "type": "string",
            "enum": [
              "first",
              "follow-up"
            ]
          },
          "define": {
            "type": "string",
            "description": "The template define that renders it."
          },
          "source_prefix": {
            "type": "string",
            "description": "Default \"<profile> guide: \"."
          }
        },
        "required": [
          "profile",
          "when",
          "define"
        ]
      },
      "description": "Other profiles the turn reads."
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "description": "Default start.",
          "enum": [
            "start",
            "turn",
            "control",
            "workspace",
            "brief",
            "intake"
          ]
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "row",
              "detail",
              "tui",
              "menubar",
              "notification",
              "cli",
              "explore"
            ]
          },
          "description": "Default [\"row\", \"detail\", \"tui\", \"cli\", \"explore\"]."
        },
        "when": {
          "type": "string",
          "description": "Action slot. Default \"row.open\". A predicate: a quoted CEL-subset expression."
        },
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "when": {
              "type": "string",
              "description": "Action slot. Default \"false\". A predicate: a quoted CEL-subset expression."
            }
          },
          "description": "When the action is the row's primary one."
        },
        "refuse": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "why"],
            "properties": {
              "when": {
                "type": "string",
                "description": "Action slot. A predicate: a quoted CEL-subset expression."
              },
              "why": {
                "type": "string",
                "description": "Template over the action facts: why the action is disabled."
              }
            }
          },
          "description": "The cases that offer the action disabled; the first that holds says why."
        },
        "note": {
          "type": "string",
          "description": "Template over the action facts: what the action would do on this row."
        },
        "warning": {
          "type": "string",
          "description": "Template over the action facts, shown under the action; empty shows nothing."
        },
        "confirm": {
          "type": "string",
          "description": "Template over the action facts."
        }
      },
      "description": "Absent: not offered anywhere."
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "differs_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Persisted input names."
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "done",
              "settled",
              "asked",
              "failed"
            ]
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "review-draft",
              "triage"
            ]
          }
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "verdict",
              "url"
            ]
          }
        },
        "outcome_doc": {
          "type": "string"
        },
        "history_artifact": {
          "type": "string",
          "description": "One of artifacts."
        },
        "require": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "verdict",
                    "url"
                  ]
                }
              }
            },
            "required": [
              "state"
            ]
          }
        }
      },
      "required": [
        "states"
      ]
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "head_moved": {
          "type": "string"
        }
      }
    },
    "modes": {
      "type": "array",
      "description": "How the intent's turns may run: session (an agent session in a workspace) and headless (one read-only call with no session). Default [\"session\"].",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "session",
          "headless"
        ]
      }
    },
    "draft_approval": {
      "type": "object",
      "additionalProperties": false,
      "description": "When the drafts this proposes are sent without the user's click. Absent: wait.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "description": "wait: the user approves each draft; delay: sent when the window ends unless the user discards or edits it first; send: sent at once; record: recorded as what would have been sent, never sent.",
          "enum": [
            "wait",
            "delay",
            "send",
            "record"
          ]
        },
        "window": {
          "type": "string",
          "description": "With mode delay only: how long the user has, such as 10m."
        },
        "rule": {
          "type": "array",
          "description": "Rules tried in order before mode; the first whose when holds gives the mode. A rule that sends on its own (send or delay) applies to a comment draft only when its when has draft.delivery == \"comment\" as a term of its top-level &&.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "mode"
            ],
            "properties": {
              "when": {
                "type": "string",
                "description": "A predicate over draft.delivery, draft.proposer, draft.effects and the facts of the unit the draft is on; never draft.purpose, which the turn's agent names."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "wait",
                  "delay",
                  "send",
                  "record"
                ],
                "description": "The mode of a draft the rule matches."
              },
              "window": {
                "type": "string",
                "description": "With mode delay only: how long the user has, such as 10m."
              }
            }
          }
        }
      }
    }
  }
}
