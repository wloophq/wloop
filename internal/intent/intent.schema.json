{
  "$id": "https://github.com/wloophq/wloop/intent.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "additionalProperties": false,
      "description": "How the intent's action is offered on a row; its description is the intent's summary.",
      "properties": {
        "confirm": {
          "description": "The dialog that confirms the action, over the action facts; empty asks nothing.",
          "type": "string"
        },
        "group": {
          "default": "start",
          "description": "The group the action is listed under.",
          "enum": [
            "start",
            "turn",
            "control",
            "workspace",
            "brief",
            "intake"
          ],
          "type": "string"
        },
        "note": {
          "description": "What the action would do on this row, over the action facts.",
          "type": "string"
        },
        "primary": {
          "additionalProperties": false,
          "description": "When the action is the row's primary one.",
          "properties": {
            "when": {
              "default": "false",
              "description": "When the action is the row's primary one.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "refuse": {
          "description": "A case that offers the action disabled; the first that holds says why.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "when": {
                "description": "When the action is offered disabled.",
                "type": "string"
              },
              "why": {
                "description": "Why the action is disabled, over the action facts.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "surfaces": {
          "description": "Where the action is offered: row, detail, tui, cli and explore when absent.",
          "items": {
            "enum": [
              "row",
              "detail",
              "tui",
              "menubar",
              "notification",
              "cli",
              "explore"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "warning": {
          "description": "Shown under the action, over the action facts; empty shows nothing.",
          "type": "string"
        },
        "when": {
          "default": "row.open",
          "description": "When the action is offered on a row.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "also_profile": {
      "description": "Other judgment the turn reads.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "define": {
            "description": "The template define that renders it.",
            "type": "string"
          },
          "dims": {
            "additionalProperties": false,
            "description": "Dimensions it pins, such as { stage = \"first\" }.",
            "properties": {
              "reviewer": {
                "description": "The pinned reviewer login.",
                "type": "string"
              },
              "stage": {
                "description": "The pinned stage.",
                "enum": [
                  "first",
                  "follow-up"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "prefix": {
            "description": "What its sources are listed under; \"<profile> guide: \" when absent.",
            "type": "string"
          },
          "profile": {
            "description": "The intent with judgment blocks.",
            "type": "string"
          },
          "when": {
            "description": "When the turn reads the other judgment.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "answerable": {
      "default": true,
      "description": "The turn may stop on a question.",
      "type": "boolean"
    },
    "brief": {
      "additionalProperties": false,
      "description": "How the turn reads the unit's brief.",
      "properties": {
        "need": {
          "description": "The brief intent's extra fields the turn needs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "render": {
          "default": true,
          "description": "The instructions carry the brief.",
          "type": "boolean"
        },
        "wait": {
          "default": true,
          "description": "The turn waits for the brief.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "builds": {
      "description": "A builder, never a turn.",
      "enum": [
        "brief"
      ],
      "type": "string"
    },
    "dims": {
      "description": "The dimensions valid under its profile.",
      "items": {
        "enum": [
          "stage",
          "reviewer"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "drafts": {
      "additionalProperties": false,
      "description": "The drafts its turns' agents propose.",
      "properties": {
        "allowed_effects": {
          "description": "The effects its agents may declare on their drafts.",
          "items": {
            "enum": [
              "entry.nudged",
              "unit.closed",
              "pr.nudged"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "approval": {
          "additionalProperties": false,
          "description": "The approval of its drafts; wait when absent.",
          "properties": {
            "mode": {
              "description": "The approval when no rule holds.",
              "enum": [
                "send",
                "delay",
                "wait",
                "dry_run"
              ],
              "type": "string"
            },
            "rule": {
              "description": "A rule; the first whose when holds gives the mode.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "description": "The rule's approval.",
                    "enum": [
                      "send",
                      "delay",
                      "wait",
                      "dry_run"
                    ],
                    "type": "string"
                  },
                  "when": {
                    "description": "When the approval rule applies to a draft.",
                    "type": "string"
                  },
                  "window": {
                    "description": "With mode delay only: how long a person has to stop the draft.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "window": {
              "description": "With mode delay only: how long a person has to stop the draft.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "effects": {
      "description": "What sending the turn applies.",
      "items": {
        "enum": [
          "plan.cleared",
          "guidance.handed",
          "pr.counted",
          "pr.round_sent",
          "pr.reviewed",
          "pr.addressed",
          "pr.nudged"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "guidance": {
      "additionalProperties": false,
      "description": "The guidance a person gives the turn.",
      "properties": {
        "help": {
          "description": "What the guidance is for.",
          "type": "string"
        },
        "label": {
          "default": "Guidance",
          "description": "The guidance's label.",
          "type": "string"
        },
        "max": {
          "default": 0,
          "description": "The guidance's length cap in runes; 0 for none.",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "headline": {
      "additionalProperties": false,
      "description": "The line that opens the turn's prompt.",
      "properties": {
        "new": {
          "description": "A headline case; the last has no when.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "line": {
                "description": "The headline, over the turn's facts.",
                "type": "string"
              },
              "when": {
                "description": "When the headline case applies.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "resumed": {
          "description": "What a resumed turn continues, over the turn's facts.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "help": {
      "additionalProperties": false,
      "description": "How its command presents it.",
      "properties": {
        "docs": {
          "description": "A page path of the documentation site.",
          "type": "string"
        },
        "examples": {
          "description": "Command lines without the command's name.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "group": {
          "description": "The title of the main help's group that lists the command, free text; action.group is the action's.",
          "type": "string"
        },
        "summary": {
          "description": "The main help's line; the intent's summary when absent.",
          "type": "string"
        },
        "target": {
          "description": "Free text saying what the command's argument names, such as a pull request URL.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "inputs": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "An input.",
        "properties": {
          "before": {
            "description": "What runs before the turn when it is set.",
            "enum": [
              "take_over"
            ],
            "type": "string"
          },
          "by_hand_only": {
            "default": false,
            "description": "An automated turn never sets it.",
            "type": "boolean"
          },
          "flag": {
            "description": "The CLI flag that sets it; required from the user.",
            "type": "string"
          },
          "from": {
            "default": "user",
            "description": "Who sets it.",
            "enum": [
              "user",
              "prepare"
            ],
            "type": "string"
          },
          "help": {
            "description": "What it does; required from the user.",
            "type": "string"
          },
          "hidden": {
            "default": false,
            "description": "Left out of help.",
            "type": "boolean"
          },
          "max": {
            "default": 0,
            "description": "A text input's length cap in runes; 0 for none.",
            "type": "integer"
          },
          "persist": {
            "default": false,
            "description": "Stored with the turn, restored on resume.",
            "type": "boolean"
          },
          "surfaces": {
            "description": "Where it is offered; cli and instructions when absent.",
            "items": {
              "enum": [
                "cli",
                "instructions",
                "try"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "description": "The input's type.",
            "enum": [
              "bool",
              "text",
              "list"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "The turn's inputs, by name.",
      "type": "object"
    },
    "intake": {
      "default": false,
      "description": "Runs through numbered intake.",
      "type": "boolean"
    },
    "join": {
      "additionalProperties": false,
      "description": "When a request joins an open turn.",
      "properties": {
        "differs_on": {
          "description": "Persisted inputs whose change starts a new turn.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "label": {
      "description": "The name people read. Required.",
      "type": "string"
    },
    "owner_only": {
      "default": false,
      "description": "The unit must be yours or taken over.",
      "type": "boolean"
    },
    "profile": {
      "description": "The intent whose judgment blocks the turn reads, or none; the configuration's profile is the profile directory.",
      "type": "string"
    },
    "prompt": {
      "description": "A builder's prompt file, through the profile layers.",
      "type": "string"
    },
    "provider": {
      "description": "The units its turns serve: a provider id, a list of them, or any; defaults.toml provider when absent.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "record": {
      "additionalProperties": false,
      "description": "The turn's record.",
      "properties": {
        "artifacts": {
          "description": "The artifacts a record may carry.",
          "items": {
            "enum": [
              "review-draft",
              "triage"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "history_artifact": {
          "description": "The artifact the unit's history shows.",
          "type": "string"
        },
        "outcome": {
          "description": "The outcome fields a record may carry.",
          "items": {
            "enum": [
              "verdict",
              "url"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "outcome_doc": {
          "description": "What the outcome holds, for the instructions.",
          "type": "string"
        },
        "require": {
          "description": "What a record in a state must carry.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact": {
                "description": "The artifact it must carry.",
                "type": "string"
              },
              "fields": {
                "description": "The outcome fields it must carry.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "state": {
                "description": "The state.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "states": {
          "description": "The states a record may take. Required.",
          "items": {
            "enum": [
              "done",
              "settled",
              "asked",
              "failed"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "when": {
          "default": "true",
          "description": "When the turn records its outcome.",
          "type": "string"
        }
      },
      "required": [
        "states"
      ],
      "type": "object"
    },
    "refuse": {
      "description": "A refusal of turn.start; the first whose when holds refuses with its why.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "when": {
            "description": "When it refuses, over the unit's workflow facts.",
            "type": "string"
          },
          "why": {
            "description": "What the refusal says, over the unit's workflow facts.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "reports": {
      "default": true,
      "description": "The turn reports.",
      "type": "boolean"
    },
    "resume": {
      "additionalProperties": false,
      "description": "What a resumed turn reads.",
      "properties": {
        "changed": {
          "description": "The text when the unit changed since the question.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "role": {
      "description": "What binds it to a plugin's mechanism. One intent per role and provider.",
      "enum": [
        "pr.review",
        "pr.address",
        "pr.nudge",
        "probe",
        "headless"
      ],
      "type": "string"
    },
    "runners": {
      "description": "How its turns may run; [\"session\"] when absent.",
      "items": {
        "enum": [
          "session",
          "headless"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "description": "A builder's extra fields' schema file, beside the manifest.",
      "type": "string"
    },
    "session": {
      "additionalProperties": false,
      "description": "The agent session its turns run in.",
      "properties": {
        "close_when_done": {
          "default": false,
          "description": "The session closes when its turn is done.",
          "type": "boolean"
        },
        "strategy": {
          "description": "Whether a turn reuses the unit's live session or starts a new one.",
          "enum": [
            "reuse_live",
            "new"
          ],
          "type": "string"
        },
        "title": {
          "description": "The session's title: 1 to 12 lowercase letters.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "shortcut": {
      "description": "One uppercase letter for its action, not a built-in action's.",
      "type": "string"
    },
    "skill": {
      "default": false,
      "description": "Install writes it a turn skill; needs help.target.",
      "type": "boolean"
    },
    "start_line": {
      "description": "The intake's first line.",
      "type": "string"
    },
    "summary": {
      "description": "One line on what it does: its action's tooltip, its help line, its profile listing. Required.",
      "type": "string"
    },
    "user_facing": {
      "default": true,
      "description": "Offered as a command, a skill and an action.",
      "type": "boolean"
    },
    "verb": {
      "description": "The GTD verb its action fulfils.",
      "enum": [
        "approve",
        "delegate",
        "dismiss"
      ],
      "type": "string"
    },
    "why": {
      "description": "Why the turn is due, over the unit's workflow facts.",
      "type": "string"
    },
    "workspace": {
      "description": "Where its turn runs, and the board it moves: a workspace builtin, or a table naming the repository.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "repo": {
              "description": "The repository the turn runs in, owner/name.",
              "type": "string"
            },
            "repo_input": {
              "description": "The input that holds the repository the turn runs in.",
              "type": "string"
            }
          },
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "label",
    "summary"
  ],
  "title": "Intent manifest (intent.toml)",
  "type": "object"
}
