{
  "$id": "https://github.com/wloophq/wloop/workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "additionalProperties": false,
      "description": "The run approval: how a matched item runs.",
      "properties": {
        "mode": {
          "default": "run",
          "description": "The mode when no rule matches.",
          "enum": [
            "run",
            "delay",
            "wait"
          ],
          "type": "string"
        },
        "rule": {
          "description": "A rule tried in order; the first whose when holds gives the mode.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "description": "The mode when the rule applies.",
                "enum": [
                  "run",
                  "delay",
                  "wait"
                ],
                "type": "string"
              },
              "when": {
                "description": "When the rule applies.",
                "type": "string"
              },
              "window": {
                "description": "The rule's window; only with mode delay, which needs it.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "window": {
          "description": "How long a person has before the item runs; only with mode delay, which needs it.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "drafts": {
      "additionalProperties": false,
      "description": "The drafts the workflow's steps and turns propose.",
      "properties": {
        "approval": {
          "additionalProperties": false,
          "description": "The approval of the drafts the workflow's steps and turns propose.",
          "properties": {
            "mode": {
              "default": "wait",
              "description": "The mode when no rule matches.",
              "enum": [
                "send",
                "delay",
                "wait",
                "dry_run"
              ],
              "type": "string"
            },
            "rule": {
              "description": "A rule tried in order; the first whose when holds gives the mode.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "description": "The mode when the rule applies.",
                    "enum": [
                      "send",
                      "delay",
                      "wait",
                      "dry_run"
                    ],
                    "type": "string"
                  },
                  "when": {
                    "description": "When the rule applies.",
                    "type": "string"
                  },
                  "window": {
                    "description": "The rule's window; only with mode delay, which needs it.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "window": {
              "description": "How long a person has before the draft is sent; only with mode delay, which needs it.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "withdraw": {
          "additionalProperties": false,
          "description": "When an open draft the workflow proposed is withdrawn.",
          "properties": {
            "reason": {
              "default": "moot",
              "description": "The reason the withdrawn draft stores.",
              "enum": [
                "assigned",
                "moot"
              ],
              "type": "string"
            },
            "when": {
              "description": "When an open draft the workflow proposed is withdrawn, over the unit's facts and the draft's.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "key": {
      "description": "The facts forming the idempotency key, by default <slot>.fingerprint: a key that ran or was dismissed is not planned again.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limits": {
      "additionalProperties": false,
      "description": "How many runs the workflow may take.",
      "properties": {
        "cooldown": {
          "description": "The least time between runs on one unit.",
          "type": "string"
        },
        "per_day": {
          "default": 0,
          "description": "Runs per local day; 0 is no limit.",
          "type": "integer"
        },
        "per_run": {
          "default": 0,
          "description": "Runs per evaluation; 0 is no limit.",
          "type": "integer"
        },
        "per_unit_per_day": {
          "default": 0,
          "description": "Runs on one unit per local day; 0 is no limit.",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "marks": {
      "additionalProperties": {
        "description": "The fact whose value the mark stores.",
        "type": "string"
      },
      "description": "Mark name to fact, stored when a run is done or dismissed, which handled() reads.",
      "type": "object"
    },
    "observe": {
      "default": false,
      "description": "Plans items pending and never runs them by itself; a person applies an item by hand.",
      "type": "boolean"
    },
    "order": {
      "default": 100,
      "description": "Evaluation order, lowest first.",
      "type": "integer"
    },
    "provider": {
      "description": "The provider of the units it matches. Required.",
      "enum": [
        "entry",
        "github",
        "session",
        "slack",
        "workspace"
      ],
      "type": "string"
    },
    "step": {
      "description": "A step the run takes, in order. Required: at least one.",
      "items": {
        "additionalProperties": {
          "description": "The step's arguments.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "use": {
                  "const": "session.close"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "session.close"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "workspace.remove"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "workspace.remove"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "workspace.unregister"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "workspace.unregister"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "turn.dismiss"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "description": "The reason the dismissed turn records.",
                  "type": "string"
                },
                "use": {
                  "const": "turn.dismiss"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "answer.refuse"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "description": "The reason the refused answer records.",
                  "type": "string"
                },
                "use": {
                  "const": "answer.refuse"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "session.mark_dormant"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "session.mark_dormant"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "turn.start"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "intent": {
                  "description": "The intent whose turn starts; it must serve the unit. Required.",
                  "type": "string"
                },
                "runner": {
                  "description": "How the turn runs, one of the intent's runners; by default its first.",
                  "enum": [
                    "session",
                    "headless"
                  ],
                  "type": "string"
                },
                "stage": {
                  "description": "The pass over the unit, for a review.",
                  "enum": [
                    "first",
                    "follow-up"
                  ],
                  "type": "string"
                },
                "use": {
                  "const": "turn.start"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "draft.propose"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "delivery": {
                  "default": "message",
                  "description": "How the draft posts.",
                  "enum": [
                    "message",
                    "reaction",
                    "comment"
                  ],
                  "type": "string"
                },
                "effects": {
                  "description": "What sending the draft applies.",
                  "items": {
                    "enum": [
                      "entry.nudged",
                      "unit.closed",
                      "pr.nudged"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                "items": {
                  "default": "all",
                  "description": "Which of the unit's items the draft lists.",
                  "enum": [
                    "owed",
                    "resolved",
                    "unowned",
                    "unowned_aged",
                    "all"
                  ],
                  "type": "string"
                },
                "per": {
                  "default": "unit",
                  "description": "One draft per unit, or one per person it waits on.",
                  "enum": [
                    "unit",
                    "person"
                  ],
                  "type": "string"
                },
                "purpose": {
                  "description": "What the draft is for, such as nudge or close. Required.",
                  "type": "string"
                },
                "reaction": {
                  "description": "The emoji name, with delivery reaction.",
                  "type": "string"
                },
                "repeat_after": {
                  "description": "The least time after a settled draft of the same person before another: a duration, or a config.* duration fact such as config.drafts.repeat_after.",
                  "type": "string"
                },
                "repeat_after_sent": {
                  "description": "The same after a sent draft, by default repeat_after: a duration, a config.* duration fact, or forever.",
                  "type": "string"
                },
                "target": {
                  "default": "unit",
                  "description": "Where the draft posts: on the unit, or on each item.",
                  "enum": [
                    "unit",
                    "item"
                  ],
                  "type": "string"
                },
                "text": {
                  "default": "text.md.tmpl",
                  "description": "The template of the draft's text, beside the manifest.",
                  "type": "string"
                },
                "use": {
                  "const": "draft.propose"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "classify"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "default": "prompt.md",
                  "description": "The classification's prompt, beside the manifest.",
                  "type": "string"
                },
                "schema": {
                  "default": "schema.json",
                  "description": "The JSON schema of its answer, beside the manifest.",
                  "type": "string"
                },
                "use": {
                  "const": "classify"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "notify.self"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "text": {
                  "default": "text.md.tmpl",
                  "description": "The notification's text, beside the manifest.",
                  "type": "string"
                },
                "use": {
                  "const": "notify.self"
                }
              }
            }
          }
        ],
        "properties": {
          "use": {
            "description": "The step.",
            "enum": [
              "session.close",
              "workspace.remove",
              "workspace.unregister",
              "turn.dismiss",
              "answer.refuse",
              "session.mark_dormant",
              "turn.start",
              "draft.propose",
              "classify",
              "notify.self"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "summary": {
      "description": "One line, what the workflow does; its plan items' description. Required.",
      "type": "string"
    },
    "trigger": {
      "additionalProperties": false,
      "description": "What plans the workflow: on or schedule; absent, every sweep.",
      "properties": {
        "on": {
          "description": "The source event kinds the workflow reacts to.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schedule": {
          "description": "A cron schedule, in local time.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "when": {
      "description": "The match condition, over the unit's facts, the trigger's and config.*. Required.",
      "type": "string"
    }
  },
  "title": "Workflow manifest (workflow.toml)",
  "type": "object"
}
