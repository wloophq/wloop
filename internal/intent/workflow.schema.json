{
  "$id": "https://github.com/wloophq/wloop/workflow.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "drafts": {
      "additionalProperties": false,
      "description": "The drafts the workflow's steps and turns propose.",
      "properties": {
        "withdraw": {
          "additionalProperties": false,
          "description": "When an open draft the workflow proposed is withdrawn.",
          "properties": {
            "reason": {
              "default": "moot",
              "description": "The reason the withdrawn draft stores.",
              "enum": [
                "assigned",
                "moot"
              ],
              "type": "string"
            },
            "when": {
              "description": "When an open draft the workflow proposed is withdrawn, over the unit's facts and the draft's.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "gates": {
      "additionalProperties": false,
      "description": "The gates its runs and drafts open.",
      "properties": {
        "approval": {
          "additionalProperties": false,
          "description": "The approval of its gates: a rule applies to the kinds its when pins gate.kind to, else to draft gates alone when it reads a draft's facts, else to every kind; what no rule or mode here decides, gates.toml's [approval] does.",
          "properties": {
            "mode": {
              "description": "The mode of every kind of gate when no rule holds; left out, gates.toml's default of the kind.",
              "enum": [
                "wait",
                "delay",
                "send",
                "dry_run",
                "run"
              ],
              "type": "string"
            },
            "rule": {
              "description": "A rule; the first whose when holds gives the mode.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "description": "The rule's mode.",
                    "enum": [
                      "wait",
                      "delay",
                      "send",
                      "dry_run",
                      "run"
                    ],
                    "type": "string"
                  },
                  "when": {
                    "description": "When the rule applies to a gate.",
                    "type": "string"
                  },
                  "window": {
                    "description": "With mode delay only: how long a person has to stop the gate's consequence.",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "window": {
              "description": "With mode delay only: how long a person has to stop the gate's consequence.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "key": {
      "description": "The facts forming the idempotency key, by default <slot>.fingerprint: a key that ran or was dismissed is not planned again. A workflow with trigger.on may add trigger.event.id, so each event plans its own run.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "limits": {
      "additionalProperties": false,
      "description": "How many runs the workflow may take.",
      "properties": {
        "cooldown": {
          "description": "The least time between runs on one unit.",
          "type": "string"
        },
        "per_day": {
          "default": 0,
          "description": "Runs per local day; 0 is no limit.",
          "type": "integer"
        },
        "per_run": {
          "default": 0,
          "description": "Runs per evaluation; 0 is no limit.",
          "type": "integer"
        },
        "per_unit_per_day": {
          "default": 0,
          "description": "Runs on one unit per local day; 0 is no limit.",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "marks": {
      "additionalProperties": {
        "description": "The fact whose value the mark stores.",
        "type": "string"
      },
      "description": "Mark name to fact, stored when a run is done or dismissed, which handled() reads.",
      "type": "object"
    },
    "observe": {
      "default": false,
      "description": "Plans items pending and never runs them by itself; a person applies an item by hand.",
      "type": "boolean"
    },
    "order": {
      "default": 100,
      "description": "Evaluation order, lowest first.",
      "type": "integer"
    },
    "provider": {
      "description": "The provider of the units it matches. Required.",
      "enum": [
        "github",
        "session",
        "slack",
        "task",
        "workspace"
      ],
      "type": "string"
    },
    "step": {
      "description": "A step the run takes, in order. Required: at least one.",
      "items": {
        "additionalProperties": {
          "description": "The step's arguments.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "use": {
                  "const": "session.close"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "session.close"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "workspace.remove"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "workspace.remove"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "workspace.unregister"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "workspace.unregister"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "turn.dismiss"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "description": "The reason the dismissed turn records.",
                  "type": "string"
                },
                "use": {
                  "const": "turn.dismiss"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "answer.refuse"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "description": "The reason the refused answer records.",
                  "type": "string"
                },
                "use": {
                  "const": "answer.refuse"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "session.mark_dormant"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "use": {
                  "const": "session.mark_dormant"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "turn.start"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "intent": {
                  "description": "The intent whose turn starts; it must serve the unit. Required.",
                  "type": "string"
                },
                "runner": {
                  "description": "How the turn runs, one of the intent's runners; by default its first.",
                  "enum": [
                    "session",
                    "headless"
                  ],
                  "type": "string"
                },
                "stage": {
                  "description": "The pass over the unit: its first, or one after.",
                  "enum": [
                    "first",
                    "follow-up"
                  ],
                  "type": "string"
                },
                "use": {
                  "const": "turn.start"
                }
              },
              "required": [
                "intent"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "draft.propose"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "delivery": {
                  "default": "message",
                  "description": "How the draft posts: the core's message or reaction, or a delivery a plugin declares.",
                  "enum": [
                    "message",
                    "reaction",
                    "comment",
                    "edit"
                  ],
                  "type": "string"
                },
                "effects": {
                  "description": "What sending the draft applies.",
                  "items": {
                    "enum": [
                      "task.nudged",
                      "unit.closed",
                      "pr.nudged"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                },
                "items": {
                  "default": "all",
                  "description": "Which of the unit's items the draft lists.",
                  "enum": [
                    "owed",
                    "resolved",
                    "unowned",
                    "unowned_aged",
                    "all"
                  ],
                  "type": "string"
                },
                "per": {
                  "default": "unit",
                  "description": "One draft per unit, or one per person it waits on.",
                  "enum": [
                    "unit",
                    "person"
                  ],
                  "type": "string"
                },
                "purpose": {
                  "description": "What the draft is for, such as nudge or close. Required.",
                  "type": "string"
                },
                "reaction": {
                  "description": "The emoji name, with delivery reaction.",
                  "type": "string"
                },
                "repeat_after": {
                  "description": "The least time after a settled draft of the same person before another: a duration, or a config.* duration fact such as config.drafts.repeat_after.",
                  "type": "string"
                },
                "repeat_after_sent": {
                  "description": "The same after a sent draft, by default repeat_after: a duration, a config.* duration fact, or forever.",
                  "type": "string"
                },
                "target": {
                  "default": "unit",
                  "description": "Where the draft posts: on the unit, or on each item; an intent's help.target is free text.",
                  "enum": [
                    "unit",
                    "item"
                  ],
                  "type": "string"
                },
                "text": {
                  "default": "text.md.tmpl",
                  "description": "The template of the draft's text, beside the manifest.",
                  "type": "string"
                },
                "use": {
                  "const": "draft.propose"
                }
              },
              "required": [
                "purpose"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "classify"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "prompt": {
                  "default": "prompt.md",
                  "description": "The classification's prompt, beside the manifest.",
                  "type": "string"
                },
                "schema": {
                  "default": "schema.json",
                  "description": "The JSON schema of its answer, beside the manifest.",
                  "type": "string"
                },
                "use": {
                  "const": "classify"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "notify.self"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "text": {
                  "default": "text.md.tmpl",
                  "description": "The template of the notification's text, beside the manifest: `.Workflow`, `.Unit` and `.Facts`.",
                  "type": "string"
                },
                "use": {
                  "const": "notify.self"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "task.verb"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "on": {
                  "description": "With a verb whose handler is waiting, the people the task waits on, comma-separated.",
                  "type": "string"
                },
                "on_activity": {
                  "description": "With a verb whose handler is schedule, `true` returns the task on new activity on its unit.",
                  "type": "string"
                },
                "resurface": {
                  "description": "With a verb whose handler is waiting, the date the task resurfaces: RFC 3339 or YYYY-MM-DD.",
                  "type": "string"
                },
                "set": {
                  "description": "With a verb whose handler is context, the contexts, comma-separated; with area, the area.",
                  "type": "string"
                },
                "until": {
                  "description": "With a verb whose handler is schedule, the date the task returns: RFC 3339 or YYYY-MM-DD.",
                  "type": "string"
                },
                "use": {
                  "const": "task.verb"
                },
                "verb": {
                  "description": "The verb of tasks.toml run on the task, one whose by.workflow lets a workflow run it. Required.",
                  "type": "string"
                }
              },
              "required": [
                "verb"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "gate.open"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "The gate, of gates.toml, the step opens. Required.",
                  "type": "string"
                },
                "use": {
                  "const": "gate.open"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "use": {
                  "const": "task.set"
                }
              },
              "required": [
                "use"
              ]
            },
            "then": {
              "additionalProperties": false,
              "properties": {
                "prop": {
                  "description": "The property, of tasks.toml, the step sets. Required.",
                  "type": "string"
                },
                "use": {
                  "const": "task.set"
                },
                "value": {
                  "description": "The value, written as its type reads it: an enum's value, a date as YYYY-MM-DD, a duration, a list comma-separated. Required.",
                  "type": "string"
                }
              },
              "required": [
                "prop",
                "value"
              ]
            }
          }
        ],
        "properties": {
          "use": {
            "description": "The step.",
            "enum": [
              "session.close",
              "workspace.remove",
              "workspace.unregister",
              "turn.dismiss",
              "answer.refuse",
              "session.mark_dormant",
              "turn.start",
              "draft.propose",
              "classify",
              "notify.self",
              "task.verb",
              "gate.open",
              "task.set"
            ],
            "type": "string"
          }
        },
        "required": [
          "use"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "summary": {
      "description": "One line, what the workflow does; its plan items' description. Required.",
      "type": "string"
    },
    "trigger": {
      "additionalProperties": false,
      "description": "What plans the workflow: on or schedule; absent, every sweep.",
      "properties": {
        "actors": {
          "description": "With on, the actors whose verb events plan it (person, workflow, agent, plugin); every actor when absent.",
          "items": {
            "enum": [
              "person",
              "workflow",
              "agent",
              "plugin"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "depth": {
          "default": 3,
          "description": "With on, the longest chain of workflows triggering each other the workflow may close: an event a chain of that many workflows caused plans it no more, and a workflow already in an event's chain never runs on it. 1 to 5.",
          "type": "integer"
        },
        "on": {
          "description": "The event kinds the workflow reacts to: the loop's, the plugins', task.woke (a task's wake matched) and verb_<verb>, a verb of tasks.toml run on a task by anyone, a workflow included; the last two with provider task.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schedule": {
          "description": "A cron schedule, in local time.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "when": {
      "description": "The match condition, over the unit's facts, the trigger's and config.*. Required.",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "step",
    "summary",
    "when"
  ],
  "title": "Workflow manifest (workflow.toml)",
  "type": "object"
}
