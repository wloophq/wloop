{
 "type": "object",
 "additionalProperties": false,
 "required": ["unchanged", "goal", "context", "kind", "risk", "risk_why", "open_questions", "tags"],
 "properties": {
  "unchanged": {"type": "boolean"},
  "goal": {"type": "string", "maxLength": 600},
  "context": {"type": "string", "maxLength": 700},
  "kind": {"type": "string", "enum": ["question", "request", "incident", "decision", "announcement"]},
  "risk": {"type": "string", "enum": ["low", "medium", "high"]},
  "risk_why": {"type": "string", "maxLength": 300},
  "open_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 200}},
  "tags": {
   "type": "object",
   "additionalProperties": false,
   "required": ["domain", "audience", "concern"],
   "properties": {
    "domain": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 40}},
    "audience": {"type": "array", "maxItems": 3, "items": {"type": "string", "enum": ["end-user", "internal", "developer", "operator"]}},
    "concern": {"type": "array", "maxItems": 3, "items": {"type": "string", "enum": ["security", "privacy", "compliance", "performance", "data-loss", "concurrency", "backward-compat", "accessibility", "i18n", "cost", "reliability"]}}
   }
  }
 }
}
