{
 "type": "object",
 "required": [
  "reviewers"
 ],
 "additionalProperties": false,
 "properties": {
  "reviewers": {
   "type": "array",
   "minItems": 1,
   "description": "The logins of the people asked to review the pull request.",
   "items": {
    "type": "string",
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
    "description": "A GitHub login, without @."
   }
  }
 }
}
